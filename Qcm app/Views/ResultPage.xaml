<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Qcm_app.Views.ResultPage"
    Title="Result">

	<VerticalStackLayout
        Padding="30"
        Spacing="24"
        VerticalOptions="Center">

		<Label
            Text="Quiz Finished!"
            FontSize="32"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

		<Label
            Text="{Binding ScoreText}"
            FontSize="42"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

		<Label
            Text="{Binding PercentageText}"
            FontSize="28"
            HorizontalOptions="Center" />

		<Label
            Text="{Binding Message}"
            FontSize="22"
            HorizontalOptions="Center" />

		<Button
            Text="Replay"
            Command="{Binding ReplayCommand}"
            HeightRequest="55" />

		<Button
            Text="Back to Home"
            Command="{Binding GoHomeCommand}"
            HeightRequest="55" />

	</VerticalStackLayout>

</ContentPage>