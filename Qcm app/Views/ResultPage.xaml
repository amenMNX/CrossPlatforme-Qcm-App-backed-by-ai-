<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Qcm_app.Views.ResultPage"
    Title="Result"
    Shell.NavBarIsVisible="False">

    <VerticalStackLayout
        Padding="28"
        Spacing="20"
        VerticalOptions="Center">

        <Border StrokeShape="RoundRectangle 28"
                BackgroundColor="{StaticResource PrimarySoft}"
                WidthRequest="72" HeightRequest="72"
                Padding="0"
                HorizontalOptions="Center"
                Stroke="Transparent">
            <Label Text="🏆" FontSize="34" HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>

        <Label
            Text="Quiz Finished!"
            Style="{StaticResource Headline}" />

        <Border Style="{StaticResource Card}" HorizontalOptions="Fill">
            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                <Label
                    Text="{Binding ScoreText}"
                    Style="{StaticResource StatNumber}"
                    FontSize="46" />

                <Label
                    Text="{Binding PercentageText}"
                    Style="{StaticResource Subtitle}"
                    FontSize="20" />
            </VerticalStackLayout>
        </Border>

        <Label
            Text="{Binding Message}"
            Style="{StaticResource SubHeadline}"
            FontSize="20" />

        <VerticalStackLayout Spacing="12" Margin="0,12,0,0">
            <Button
                Text="Replay"
                Command="{Binding ReplayCommand}"
                HeightRequest="56" />

            <Button
                Text="Back to Home"
                Style="{StaticResource SecondaryButton}"
                Command="{Binding GoHomeCommand}"
                HeightRequest="52" />
        </VerticalStackLayout>

    </VerticalStackLayout>

</ContentPage>
