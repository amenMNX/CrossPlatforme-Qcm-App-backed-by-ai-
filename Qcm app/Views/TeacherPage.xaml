<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Qcm_app.ViewModels"
    x:Class="Qcm_app.Views.TeacherPage"
    x:DataType="viewModels:TeacherViewModel"
    Title="Teacher">

    <ScrollView>
        <VerticalStackLayout Padding="24,20,24,32" Spacing="20">

            <VerticalStackLayout Spacing="4">
                <Label Text="TEACHER TOOLS" Style="{StaticResource Eyebrow}" />
                <Label Text="Add a question" Style="{StaticResource CardTitle}" FontSize="22" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Question" Style="{StaticResource Caption}" FontAttributes="Bold" />
                        <Editor
                            Text="{Binding QuestionText}"
                            Placeholder="Enter the question"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="80" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Choices" Style="{StaticResource Caption}" FontAttributes="Bold" />
                        <Entry Text="{Binding Choice1}" Placeholder="Choice 1" />
                        <Entry Text="{Binding Choice2}" Placeholder="Choice 2" />
                        <Entry Text="{Binding Choice3}" Placeholder="Choice 3" />
                        <Entry Text="{Binding Choice4}" Placeholder="Choice 4" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Correct choice" Style="{StaticResource Caption}" FontAttributes="Bold" />
                        <Picker
                            Title="Select the correct choice"
                            ItemsSource="{Binding CorrectChoiceOptions}"
                            SelectedIndex="{Binding CorrectChoiceIndex}" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Category" Style="{StaticResource Caption}" FontAttributes="Bold" />
                            <Entry Text="{Binding Category}" Placeholder="e.g. Science" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Difficulty" Style="{StaticResource Caption}" FontAttributes="Bold" />
                            <Picker
                                ItemsSource="{Binding DifficultyOptions}"
                                SelectedItem="{Binding SelectedDifficulty}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label
                        Text="{Binding StatusMessage}"
                        Style="{StaticResource Caption}"
                        HorizontalTextAlignment="Center" />

                    <ActivityIndicator
                        IsRunning="{Binding IsSaving}"
                        IsVisible="{Binding IsSaving}"
                        Color="{StaticResource Primary}" />

                    <Button
                        Text="Save question"
                        Command="{Binding SaveQuestionCommand}"
                        HeightRequest="52" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="4" Margin="0,8,0,0">
                <Label Text="AUTOMATE" Style="{StaticResource Eyebrow}" />
                <Label Text="Generate questions with AI" Style="{StaticResource CardTitle}" FontSize="22" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Entry
                        Text="{Binding AiTopic}"
                        Placeholder="Topic, e.g. astronomy" />

                    <Entry
                        Text="{Binding AiQuestionCount}"
                        Placeholder="Number of questions (1–20)"
                        Keyboard="Numeric" />

                    <Button
                        Text="Generate preview"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding GenerateAiQuestionsCommand}" />

                    <ActivityIndicator
                        IsRunning="{Binding IsGenerating}"
                        IsVisible="{Binding IsGenerating}"
                        Color="{StaticResource Primary}" />

                    <Label
                        Text="{Binding AiStatusMessage}"
                        Style="{StaticResource Caption}"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout
                BindableLayout.ItemsSource="{Binding AiPreviewQuestions}"
                Spacing="14">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:TeacherQuestionDraft">
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="AI DRAFT" Style="{StaticResource Eyebrow}" />
                                <Editor
                                    Text="{Binding Text}"
                                    Placeholder="Question"
                                    AutoSize="TextChanges"
                                    MinimumHeightRequest="70" />
                                <Entry Text="{Binding Choice1}" Placeholder="Choice 1" />
                                <Entry Text="{Binding Choice2}" Placeholder="Choice 2" />
                                <Entry Text="{Binding Choice3}" Placeholder="Choice 3" />
                                <Entry Text="{Binding Choice4}" Placeholder="Choice 4" />
                                <Entry Text="{Binding Category}" Placeholder="Category" />
                                <Picker
                                    Title="Correct choice"
                                    ItemsSource="{Binding CorrectChoiceOptions}"
                                    SelectedIndex="{Binding CorrectIndex}" />
                                <Picker
                                    Title="Difficulty"
                                    ItemsSource="{Binding DifficultyOptions}"
                                    SelectedItem="{Binding Difficulty}" />
                                <Button
                                    Text="Accept and save"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SavePreviewQuestionCommand}"
                                    CommandParameter="{Binding .}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
