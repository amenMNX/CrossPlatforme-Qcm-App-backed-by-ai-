<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:viewModels="clr-namespace:Qcm_app.ViewModels"
	x:Class="Qcm_app.Views.TeacherLoginPage"
	x:DataType="viewModels:TeacherLoginViewModel"
	Title="Teacher access"
	Shell.NavBarIsVisible="False">

	<VerticalStackLayout Padding="28" Spacing="18" VerticalOptions="Center">

		<Border StrokeShape="RoundRectangle 28"
				BackgroundColor="{StaticResource PrimarySoft}"
				WidthRequest="64" HeightRequest="64"
				Padding="0"
				HorizontalOptions="Center"
				Stroke="Transparent">
			<Label Text="🔒" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center" />
		</Border>

		<Label
			Text="Teacher access"
			Style="{StaticResource Headline}"
			FontSize="26" />

		<Border Style="{StaticResource Card}">
			<VerticalStackLayout Spacing="10">
				<Entry
					Placeholder="Password"
					IsPassword="True"
					Text="{Binding Password}"
					ReturnType="Go"
					ReturnCommand="{Binding LoginCommand}" />

				<Label
					Text="{Binding ErrorMessage}"
					TextColor="{StaticResource Danger}"
					FontSize="13"
					HorizontalTextAlignment="Center" />
			</VerticalStackLayout>
		</Border>

		<Button
			Text="Continue"
			Command="{Binding LoginCommand}"
			HeightRequest="52" />

		<Button
			Text="Cancel"
			Command="{Binding CancelCommand}"
			Style="{StaticResource GhostButton}"
			HorizontalOptions="Center" />
	</VerticalStackLayout>
</ContentPage>
