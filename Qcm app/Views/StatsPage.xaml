<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Qcm_app.ViewModels"
    x:Class="Qcm_app.Views.StatsPage"
    x:DataType="viewModels:StatsViewModel"
    Title="Stats">

    <VerticalStackLayout Padding="24,20" Spacing="16" VerticalOptions="Center">

        <VerticalStackLayout
            Spacing="10"
            HorizontalOptions="Center"
            IsVisible="{Binding HasNoData}">
            <Label Text="📊" FontSize="40" HorizontalOptions="Center" />
            <Label
                Text="No stats yet. Play a few quizzes first!"
                Style="{StaticResource Subtitle}" />
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="14"
            IsVisible="{Binding HasNoData, Converter={StaticResource InvertedBoolConverter}}">

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Label Text="Games played" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                    <Label Text="{Binding GamesPlayed}" Style="{StaticResource StatNumber}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Label Text="Best score" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                    <Label Text="{Binding BestScoreText}" Style="{StaticResource StatNumber}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Label Text="Average score" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                    <Label Text="{Binding AverageScoreText}" Style="{StaticResource StatNumber}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>

    </VerticalStackLayout>

</ContentPage>
