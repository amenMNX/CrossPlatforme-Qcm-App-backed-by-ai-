<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Qcm_app.ViewModels"
    xmlns:data="clr-namespace:Qcm_app.Data"
    x:Class="Qcm_app.Views.HistoryPage"
    x:DataType="viewModels:HistoryViewModel"
    Title="History">

    <Grid Padding="24,20">

        <VerticalStackLayout
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Spacing="10"
            IsVisible="{Binding IsEmpty}">
            <Label Text="📭" FontSize="40" HorizontalOptions="Center" />
            <Label
                Text="No games played yet"
                Style="{StaticResource CardTitle}"
                HorizontalOptions="Center" />
            <Label
                Text="Play a quiz to see it here!"
                Style="{StaticResource Subtitle}" />
        </VerticalStackLayout>

        <CollectionView
            ItemsSource="{Binding Sessions}"
            IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBoolConverter}}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="data:GameSession">
                    <Border Style="{StaticResource Card}" Padding="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="{Binding Category}" Style="{StaticResource CardTitle}" />
                                <Label FontSize="13" TextColor="{StaticResource InkMuted}">
                                    <Label.Text>
                                        <MultiBinding StringFormat="{}{0:g} · {1}">
                                            <Binding Path="Date" />
                                            <Binding Path="Difficulty" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                            </VerticalStackLayout>
                            <Border Grid.Column="1"
                                    BackgroundColor="{StaticResource PrimarySoft}"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="Transparent"
                                    Padding="12,6"
                                    VerticalOptions="Center">
                                <Label
                                    FontSize="16"
                                    FontFamily="OpenSansSemibold"
                                    TextColor="{StaticResource Primary}"
                                    VerticalOptions="Center">
                                    <Label.Text>
                                        <MultiBinding StringFormat="{}{0}/{1}">
                                            <Binding Path="Score" />
                                            <Binding Path="TotalQuestions" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
