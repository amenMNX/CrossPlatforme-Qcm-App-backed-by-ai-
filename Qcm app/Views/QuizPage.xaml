<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Qcm_app.ViewModels"
    x:Class="Qcm_app.Views.QuizPage"
    x:DataType="viewModels:QuizViewModel"
    Title="Quiz">

    <ContentPage.Resources>
        <Style x:Key="QuizAnswerButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
            <Setter Property="TextColor" Value="{StaticResource InkStrong}" />
            <Setter Property="BorderColor" Value="{StaticResource CardStroke}" />
            <Setter Property="BorderWidth" Value="1.5" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalOptions" Value="Fill" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="HeightRequest" Value="56" />
            <Setter Property="Shadow">
                <Shadow Brush="{StaticResource MidnightBlue}" Opacity="0.05" Radius="12" Offset="0,4" />
            </Setter>
        </Style>
        <Style x:Key="QuizNextButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
            <Setter Property="TextColor" Value="{StaticResource White}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HeightRequest" Value="54" />
        </Style>
    </ContentPage.Resources>

    <Grid Padding="22,20">

        <VerticalStackLayout Spacing="16" VerticalOptions="Center"
            IsVisible="{Binding IsQuizReady}">

            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                <VerticalStackLayout Spacing="2">
                    <Label Text="QUIZ" Style="{StaticResource Eyebrow}" />
                    <Label Text="Challenge yourself" Style="{StaticResource CardTitle}" FontSize="22" />
                </VerticalStackLayout>
                <Border Grid.Column="1"
                        BackgroundColor="{StaticResource PrimarySoft}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="Transparent"
                        Padding="12,6"
                        VerticalOptions="Center">
                    <Label Text="{Binding ScoreText}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{StaticResource Primary}" />
                </Border>
            </Grid>

            <ProgressBar Progress="{Binding Progress}" HeightRequest="8" />

            <Label
                Text="{Binding ProgressText}"
                Style="{StaticResource Caption}"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Border Style="{StaticResource Card}" Padding="22">
                <Label Text="{Binding CurrentQuestion.Text}" FontSize="22" FontFamily="OpenSansSemibold" TextColor="{StaticResource InkStrong}" HorizontalTextAlignment="Center" />
            </Border>

            <CollectionView
                ItemsSource="{Binding CurrentQuestion.Choices}"
                SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Button
                            x:DataType="{x:Null}"
                            Text="{Binding .}"
                            Style="{StaticResource QuizAnswerButton}"
                            IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.IsAnswered, Converter={StaticResource InvertedBoolConverter}}"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectAnswerCommand}"
                            CommandParameter="{Binding .}"
                            Margin="0,5" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Border Padding="14" StrokeShape="RoundRectangle 14" Stroke="Transparent"
                    BackgroundColor="{StaticResource PrimarySoft}"
                    IsVisible="{Binding IsAnswered}">
                <Label Text="{Binding FeedbackMessage}" FontSize="16" FontFamily="OpenSansSemibold" TextColor="{StaticResource Primary}" HorizontalTextAlignment="Center" />
            </Border>

            <Button Text="Next question"
                Style="{StaticResource QuizNextButton}"
                Command="{Binding NextCommand}"
                IsVisible="{Binding IsAnswered}"
                Margin="0,4,0,0" />

        </VerticalStackLayout>

        <VerticalStackLayout
            Spacing="16"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            IsVisible="{Binding HasGenerationError}">
            <Label
                Text="Could not load questions"
                Style="{StaticResource SubHeadline}"
                FontSize="20" />
            <Label
                Text="{Binding FeedbackMessage}"
                Style="{StaticResource Subtitle}" />
            <Button
                Text="Try again"
                Command="{Binding RetryCommand}" />
        </VerticalStackLayout>

        <VerticalStackLayout
            Spacing="16"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            IsVisible="{Binding IsLoading}">
            <ActivityIndicator IsRunning="{Binding IsLoading}" HeightRequest="48" WidthRequest="48" Color="{StaticResource Primary}" />
            <Label
                Text="{Binding LoadingMessage}"
                Style="{StaticResource Subtitle}" />
        </VerticalStackLayout>

    </Grid>

</ContentPage>
