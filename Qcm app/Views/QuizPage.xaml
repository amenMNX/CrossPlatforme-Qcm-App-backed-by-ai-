<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Qcm_app.ViewModels"
    x:Class="Qcm_app.Views.QuizPage"
    x:DataType="viewModels:QuizViewModel"
    Title="Quiz"
    BackgroundColor="#F7F5FC">

    <ContentPage.Resources>
        <Style x:Key="QuizAnswerButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#FFFFFF" />
            <Setter Property="TextColor" Value="#29233F" />
            <Setter Property="BorderColor" Value="#DDD6F3" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="HeightRequest" Value="56" />
        </Style>
        <Style x:Key="QuizNextButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#512BD4" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HeightRequest" Value="54" />
        </Style>
    </ContentPage.Resources>

	<Grid Padding="20">

		<VerticalStackLayout Spacing="16" VerticalOptions="Center"
			IsVisible="{Binding IsQuizReady}">

			<Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
				<VerticalStackLayout Spacing="2">
                    <Label Text="{Binding QuizModeText}" FontSize="12" FontAttributes="Bold" TextColor="#512BD4" />
                    <Label Text="{Binding TopicText}" FontSize="22" FontAttributes="Bold" TextColor="#29233F" />
                    <Label Text="{Binding DifficultyText}" FontSize="13" TextColor="#6B647A" />
				</VerticalStackLayout>
				<Label Grid.Column="1" Text="{Binding ScoreText}" FontSize="15" FontAttributes="Bold" TextColor="#512BD4" VerticalOptions="Center" />
			</Grid>

			<ProgressBar Progress="{Binding Progress}" ProgressColor="#512BD4" HeightRequest="8" />
            <Label Text="{Binding SourceMessage}" IsVisible="{Binding HasSourceMessage}" FontSize="13" TextColor="#8A5A00" HorizontalTextAlignment="Center" />

			<Label
                Text="{Binding ProgressText}"
				FontSize="14"
				FontAttributes="Bold"
				TextColor="{StaticResource Gray500}"
                HorizontalOptions="Center" />
			<Frame Padding="22" CornerRadius="20" HasShadow="False" BackgroundColor="White" BorderColor="#E4DFF2">
				<Label Text="{Binding CurrentQuestion.Text}" FontSize="24" FontAttributes="Bold" TextColor="#29233F" HorizontalTextAlignment="Center" />
			</Frame>

			<CollectionView
                ItemsSource="{Binding CurrentQuestion.Choices}"
                SelectionMode="None">

				<CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
						<Button
                            x:DataType="{x:Null}"
                            Text="{Binding .}"
                            Style="{StaticResource QuizAnswerButton}"
                            IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.IsAnswered, Converter={StaticResource InvertedBoolConverter}}"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectAnswerCommand}"
                            CommandParameter="{Binding .}"
                            Margin="0,5"
                            HeightRequest="55" />
					</DataTemplate>
				</CollectionView.ItemTemplate>

			</CollectionView>

			<Frame Padding="14" CornerRadius="14" HasShadow="False" BackgroundColor="#EFEAFF" IsVisible="{Binding IsAnswered}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding FeedbackTitle}" FontSize="16" FontAttributes="Bold" TextColor="{Binding FeedbackColor}" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding FeedbackMessage}" FontSize="15" TextColor="#29233F" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
			</Frame>

			<Button Text="Next question"
				Style="{StaticResource QuizNextButton}"
				Command="{Binding NextCommand}"
				IsVisible="{Binding IsAnswered}"
				Margin="0,4,0,0" />

		</VerticalStackLayout>

        <VerticalStackLayout
            Spacing="16"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            IsVisible="{Binding HasGenerationError}">
            <Label
                Text="Could not load questions"
                FontSize="22"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center" />
            <Label
                Text="{Binding FeedbackMessage}"
                FontSize="16"
                HorizontalTextAlignment="Center" />
            <Button
                Text="Try again"
                Command="{Binding RetryCommand}" />
        </VerticalStackLayout>

		<VerticalStackLayout
            Spacing="16"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            IsVisible="{Binding IsLoading}">
			<ActivityIndicator IsRunning="{Binding IsLoading}" HeightRequest="48" WidthRequest="48" />
			<Label
                Text="{Binding LoadingMessage}"
                FontSize="16"
                HorizontalTextAlignment="Center" />
		</VerticalStackLayout>

	</Grid>

</ContentPage>
