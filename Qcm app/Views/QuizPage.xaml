<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Qcm_app.ViewModels"
    x:Class="Qcm_app.Views.QuizPage"
    x:DataType="viewModels:QuizViewModel"
    Title="Quiz">

	<Grid Padding="24">

		<VerticalStackLayout
            Spacing="20"
            VerticalOptions="Center"
            IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">

			<Label
                Text="{Binding ProgressText}"
                FontSize="18"
                HorizontalOptions="Center" />
			<Label
                Text="{Binding CurrentQuestion.Text}"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center" />

			<CollectionView
                ItemsSource="{Binding CurrentQuestion.Choices}"
                SelectionMode="None">

				<CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
						<Button
                            x:DataType="{x:Null}"
                            Text="{Binding .}"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectAnswerCommand}"
                            CommandParameter="{Binding .}"
                            Margin="0,5"
                            HeightRequest="55" />
					</DataTemplate>
				</CollectionView.ItemTemplate>

			</CollectionView>

			<Label
                Text="{Binding FeedbackMessage}"
                FontSize="18"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center" />

		</VerticalStackLayout>

		<VerticalStackLayout
            Spacing="16"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            IsVisible="{Binding IsLoading}">
			<ActivityIndicator IsRunning="{Binding IsLoading}" HeightRequest="48" WidthRequest="48" />
			<Label
                Text="{Binding LoadingMessage}"
                FontSize="16"
                HorizontalTextAlignment="Center" />
		</VerticalStackLayout>

	</Grid>

</ContentPage>
