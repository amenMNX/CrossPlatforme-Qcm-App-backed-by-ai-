<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Qcm_app.ViewModels"
    x:Class="Qcm_app.Views.CategoriesPage"
    x:DataType="viewModels:CategoriesViewModel"
    Title="Categories">

    <ScrollView>
        <VerticalStackLayout Padding="24,20,24,32" Spacing="20">

            <VerticalStackLayout Spacing="4">
                <Label Text="SET UP YOUR QUIZ" Style="{StaticResource Eyebrow}" />
                <Label Text="Pick a category and difficulty" Style="{StaticResource CardTitle}" FontSize="22" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="16">

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Category" Style="{StaticResource Caption}" FontAttributes="Bold" />
                        <Picker
                            ItemsSource="{Binding Categories}"
                            SelectedItem="{Binding SelectedCategory}" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="{StaticResource CardStroke}" />

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Difficulty" Style="{StaticResource Caption}" FontAttributes="Bold" />
                        <Picker
                            ItemsSource="{Binding DifficultyOptions}"
                            SelectedItem="{Binding SelectedDifficulty}" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <HorizontalStackLayout Spacing="14">
                    <Switch IsToggled="{Binding UseAiGeneration}" VerticalOptions="Start" />
                    <VerticalStackLayout Spacing="2" HorizontalOptions="FillAndExpand">
                        <Label
                            Text="Generate questions with AI"
                            Style="{StaticResource CardTitle}" />
                        <Label
                            Text="Uses Gemini to create fresh questions. Falls back to the local bank if offline."
                            Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

            <Button
                Text="Start Quiz"
                Command="{Binding StartCommand}"
                HeightRequest="56"
                FontSize="18"
                Margin="0,8,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
