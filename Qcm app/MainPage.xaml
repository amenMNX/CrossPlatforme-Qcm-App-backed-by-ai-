<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Qcm_app.ViewModels"
    x:Class="Qcm_app.MainPage"
    x:DataType="viewModels:HomeViewModel"
    Title="Quiz App"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout
            Padding="28,48,28,32"
            Spacing="28"
            VerticalOptions="Center">

            <VerticalStackLayout Spacing="10">
                <Border StrokeShape="RoundRectangle 28"
                        BackgroundColor="{StaticResource PrimarySoft}"
                        WidthRequest="64" HeightRequest="64"
                        Padding="0"
                        HorizontalOptions="Center"
                        Stroke="Transparent">
                    <Label Text="🧠" FontSize="30" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <Label Text="Quiz App" Style="{StaticResource Headline}" />
                <Label
                    Text="Test your knowledge with fun, fast quizzes."
                    Style="{StaticResource Subtitle}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="14">
                <Button
                    Text="▶  Start Quiz"
                    Command="{Binding StartQuizCommand}"
                    HeightRequest="58"
                    FontSize="18" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                    <Button
                        Grid.Column="0"
                        Text="History"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ViewHistoryCommand}"
                        HeightRequest="52" />

                    <Button
                        Grid.Column="1"
                        Text="Stats"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ViewStatsCommand}"
                        HeightRequest="52" />
                </Grid>

                <Button
                    Text="Teacher mode"
                    Command="{Binding OpenTeacherModeCommand}"
                    Style="{StaticResource GhostButton}"
                    HorizontalOptions="Center" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
